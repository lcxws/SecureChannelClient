<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.securechannel</groupId>
    <artifactId>SecureChannelClient</artifactId>
    <version>1.0.4</version>
    <packaging>jar</packaging>

    <name>SecureChannelClient</name>
    <description>SecureChannel 配套 Forge 客户端（1.20.1）：允许离线玩家完成加密握手</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>
    </properties>

    <dependencies>
        <!-- 编译期参考；运行时由游戏自带，不打包 -->
        <dependency>
            <groupId>org.spongepowered</groupId>
            <artifactId>mixin</artifactId>
            <version>0.8.5</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/tools/mixin-0.8.5.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.mojang</groupId>
            <artifactId>authlib</artifactId>
            <version>4.0.43</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/tools/authlib-4.0.43.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.10.1</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>SecureChannelClient-1.0.4</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <!-- 目标（authlib）未混淆，无需生成 refmap，禁用 Mixin 注解处理器 -->
                    <proc>none</proc>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <!-- net/minecraftforge 与 net/minecraft 下的编译桩不进 jar（运行时用游戏真实类） -->
                    <excludes>
                        <exclude>net/minecraftforge/**</exclude>
                        <exclude>net/minecraft/**</exclude>
                    </excludes>
                    <archive>
                        <manifestEntries>
                            <MixinConfigs>mixins.securechannelclient.json</MixinConfigs>
                            <Specification-Title>securechannelclient</Specification-Title>
                            <Specification-Version>1</Specification-Version>
                            <Implementation-Title>SecureChannelClient</Implementation-Title>
                            <Implementation-Version>1.0.0</Implementation-Version>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
